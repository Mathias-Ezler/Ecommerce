---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props { title?: string; description?: string }
const { title = "GLAM — Moda Moderna & Minimalista", description = "Moda moderna y minimalista en escala de grises." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600;700&family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body class="bg-neutral-950 text-neutral-100 font-sans antialiased selection:bg-neutral-100 selection:text-neutral-950 flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow"><slot /></main>
    <Footer />

    <script>
      // Selección de talle -> actualiza el mensaje de WhatsApp de ese producto
      document.querySelectorAll<HTMLElement>("[data-product]").forEach((root) => {
        const link = root.querySelector<HTMLAnchorElement>("[data-wa]");
        const buttons = root.querySelectorAll<HTMLButtonElement>(".size-btn");
        if (!link) return;

        const phonePath = new URL(link.href).pathname; // "/5959..."

        const update = (size: string) => {
          const text = (link.dataset.template ?? "").replace("{size}", size ? `Talle: ${size}. ` : "");
          link.href = `https://wa.me${phonePath}?text=${encodeURIComponent(text)}`;
        };

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
            update(btn.dataset.size ?? "");
          });
        });

        // Producto de talle único: se preselecciona
        if (buttons.length === 1) buttons[0].click();
      });
    </script>
  </body>
</html>